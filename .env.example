# ============================================================
# AI-Invoice Auditor | 環境變數設定範本 (.env.example)
# ============================================================

# [選填] Google Gemini 多模態 API Key (若為空則可使用 OpenRouter / Ollama / Mock 模式)
GEMINI_API_KEY=

# [選填] OpenRouter API Key（可使用 Google Gemma 4 31B 等免費多模態視覺模型，適合作為 POC 驗證引擎）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# [正式環境必改] JWT 驗證與檔案簽章預覽密鑰
# 正式部署時請務必替換為高強度隨機字串 (例如：openssl rand -hex 32)
JWT_SECRET_KEY=ai-invoice-auditor-enterprise-secret-key-2026

# [正式環境必改] SQLAdmin 管理後台 (/admin) Session 加密密鑰
# 若未設定將使用內建開發預設值；正式部署請務必設定為高強度隨機字串
ADMIN_SESSION_SECRET=

# [選填] 資料庫連線 (預設為 sqlite:///data/invoices.db)
# 若未來遷移至 PostgreSQL，可改為：postgresql://user:password@localhost:5432/invoice_db
DATABASE_URL=sqlite:///data/invoices.db

# [選填] 事務機掃描監控資料夾 (Watch Folder) 與自動輪詢間隔（秒，0 代表僅手動觸發）
WATCH_FOLDER_DIR=data/watch_inbox
WATCH_FOLDER_AUTO_POLL_SECONDS=0
